flowchart LR
  OUT[("DynamoDB<br/>autorizacoes-outbox")]
  RELAY["Lambda desafio-relay<br/>(Stream do outbox)"]
  SWEEP["Lambda desafio-sweeper"]
  SCHED["EventBridge Scheduler<br/>rate(5 minutes)"]
  LIM[("DynamoDB limites")]
  CDC["Lambda desafio-relay-cdc-limites<br/>(Stream, só MODIFY)"]
  BUS{{"Bus EventBridge financas"}}
  ARC[("Archive financas-archive<br/>30 dias")]

  OUT -- Stream --> RELAY
  SCHED --> SWEEP
  SWEEP -- "lê o outbox" --> OUT
  RELAY -- PutEvents --> BUS
  SWEEP -- PutEvents --> BUS
  LIM -- Stream --> CDC
  CDC -- "PutEvents: LimiteAlterado" --> BUS
  BUS --> ARC

  R1["regra para-antifraude<br/>Autorizada, Recusada"]
  R2["regra para-contabilizacao<br/>Autorizada, Estornada,<br/>ReservaExpirada, ReservaCapturada"]
  R3["regra para-notificacoes<br/>Autorizada, Recusada, Estornada"]
  R4["regra limite-alterado-<br/>para-notificacoes<br/>LimiteAlterado"]
  R5["regra para-plataforma-<br/>de-dados<br/>todos os eventos"]
  BUS --> R1
  BUS --> R2
  BUS --> R3
  BUS --> R4
  BUS --> R5

  Q1[[SQS antifraude]] --> D1[[antifraude-dlq]]
  Q2[[SQS contabilizacao]] --> D2[[contabilizacao-dlq]]
  Q3[[SQS notificacoes]] --> D3[[notificacoes-dlq]]
  R1 --> Q1
  R2 --> Q2
  R3 --> Q3
  R4 --> Q3
  DLQE[[financas-entrega-dlq<br/>entrega regra → fila que falhou]]
  R1 -.-> DLQE
  R2 -.-> DLQE
  R3 -.-> DLQE
  R4 -.-> DLQE
  R5 -.-> DLQE
  FH["Firehose<br/>data platform"]
  S3P[("S3 data platform<br/>partição por tipo e data")]
  R5 --> FH
  FH --> S3P

  CAF["Lambda desafio-<br/>consumidor-antifraude<br/>valida o schema"]
  IAF[("DynamoDB<br/>inbox do consumidor<br/>de antifraude")]
  CNT["Lambda desafio-<br/>consumidor-notificacoes<br/>valida o schema"]
  INT[("DynamoDB<br/>inbox do consumidor<br/>de notificações")]
  Q1 --> CAF
  CAF --> IAF
  Q3 --> CNT
  CNT --> INT

  CTB["Lambda desafio-contabilizacao"]
  INB[("DynamoDB<br/>contabilizacao-inbox")]
  LAN[("DynamoDB<br/>contabilizacao-lancamentos")]
  Q2 --> CTB
  CTB --> INB
  CTB --> LAN
