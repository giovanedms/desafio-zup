# Copie para terraform.tfvars (ignorado pelo git se contiver segredos; aqui não há segredos).
# Também dá para passar só o essencial: make deploy já faz -var account_id=$(EXPECTED_ACCOUNT_ID).

account_id  = "123456789012" # conta desafio-zup (12 dígitos)
aws_profile = "desafio-zup"

# Tags imutáveis no ECR: cada release de imagem exige uma tag nova.
tag_imagem_autorizacao = "1.0.0"
tag_imagem_limites     = "1.0.0"

# Capacidade (ADR-0004). O pico previsível usa janelas agendadas (var.janelas_de_pico; o default sobe o mínimo
# para 4 no dia 1 de cada mês, 06:30–12:00 de Brasília). Para desligar: janelas_de_pico = []
tasks_desejadas = 2
tasks_min       = 2
tasks_max       = 20

# Load shedding: null deriva de cpu (18 com 512). Shards dos GSIs esparsos: só subir.
# max_em_voo         = 18
# shards_dos_indices = 64

# Warm throughput (pré-aquecimento) do DynamoDB: DESLIGADO no sandbox (cobrado e irreversível). Produção, 2x o pico:
# warm_throughput = {
#   limites      = { escrita = 11000 }
#   autorizacoes = { escrita = 31000, indices = { gsi_orfas = { escrita = 20000 } } }
# }

# Alarmes: e-mail assinado no tópico SNS (vazio = sem assinatura; a AWS pede confirmação por e-mail).
# email_alarmes = "plantao@exemplo.com"

# Proteção contra exclusão: false no sandbox para o destroy funcionar; true em produção.
deletion_protection = false

# WAF (429): requisições em 5 minutos por x-api-key e por IP. A medição com k6 (canal-carga, um IP) sobe os dois.
waf_limite_por_consumidor = 120000
waf_limite_por_ip         = 300000

# Janela de medição (k6 com o canal-carga). O default estaciona o plano-carga em 200 rps (metade do teto do WAF por
# consumidor). Para refazer os degraus de docs/capacidade.md, subir os TRÊS juntos e voltar ao default depois:
# plano_carga               = { rate_limit = 6000, burst_limit = 5000, quota_dia = 50000000 }
# waf_limite_por_consumidor = 2000000  # >= rate_limit x 300 s, com folga
# waf_limite_por_ip         = 20000000 # o k6 sai de um IP só
