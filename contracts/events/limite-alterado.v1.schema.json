{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://financas.example/schemas/eventos/limite-alterado/1.0.json",
  "title": "LimiteAlterado v1 (CloudEvent estruturado)",
  "description": "Limite concedido ou status do contrato alterado pelo core (via ACL). Baixa volumetria: NÃO é emitido por reserva. Publicado em EventBridge com o CloudEvent inteiro em `detail` (DetailType = nome curto). Evolução: só campos opcionais novos dentro do major (BACKWARD); consumidores ignoram campos desconhecidos.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "subject",
    "data"
  ],
  "properties": {
    "specversion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Gerado no outbox; estável entre reentregas. Dedup por (source, id)."
    },
    "source": {
      "type": "string",
      "enum": [
        "/financas/limites"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "example.financas.limites.LimiteAlterado.v1"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "id_contrato"
    },
    "datacontenttype": {
      "type": "string",
      "enum": [
        "application/json"
      ]
    },
    "dataschema": {
      "type": "string",
      "enum": [
        "https://financas.example/schemas/eventos/limite-alterado/1.0.json"
      ]
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "description": "Extensão CE Distributed Tracing."
    },
    "correlationid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Extensão própria (nomes de atributo CE não aceitam `_`)."
    },
    "partitionkey": {
      "type": "string",
      "description": "Extensão CE Partitioning = id_contrato (útil se o stream migrar para Kinesis/Kafka)."
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "occurred_at",
        "id_contrato",
        "correlation_id",
        "trace_id",
        "limite_concedido",
        "status_contrato",
        "versao_limite",
        "versao_legado",
        "origem"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Espelho do atributo CE `id` (campo do enunciado)."
        },
        "event_type": {
          "type": "string",
          "enum": [
            "LimiteAlterado"
          ],
          "description": "Espelho do nome curto (campo do enunciado)."
        },
        "event_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$",
          "description": "Versão do schema; major também no CE `type`."
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "Instante do fato de negócio (UTC); espelho do CE `time`."
        },
        "id_contrato": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{32}$",
          "description": "W3C trace-id; o traceparent completo vai na extensão CE `traceparent`."
        },
        "limite_concedido_anterior": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+16
        },
        "limite_concedido": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+16
        },
        "status_contrato_anterior": {
          "type": "string",
          "enum": [
            "ATIVO",
            "BLOQUEADO",
            "ENCERRADO"
          ]
        },
        "status_contrato": {
          "type": "string",
          "enum": [
            "ATIVO",
            "BLOQUEADO",
            "ENCERRADO"
          ]
        },
        "limite_disponivel": {
          "type": "number",
          "description": "Pode ser negativo só se o core reduziu o limite concedido."
        },
        "versao_limite": {
          "type": "integer",
          "minimum": 1
        },
        "versao_legado": {
          "type": "integer",
          "minimum": 0
        },
        "origem": {
          "type": "string",
          "enum": [
            "CORE_LEGADO"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
