# Arquitetura hexagonal: adapters > application > domain; núcleo sem framework nem AWS SDK.
[importlinter]
root_packages =
    autorizacao
    limites
    contabilizacao
    relay
    plataforma
include_external_packages = True

[importlinter:contract:autorizacao-layers]
name = autorizacao: adapters > application > domain
type = layers
layers =
    autorizacao.adapters
    autorizacao.application
    autorizacao.domain

[importlinter:contract:autorizacao-nucleo-puro]
name = autorizacao: domain e application sem framework nem AWS SDK
type = forbidden
source_modules =
    autorizacao.domain
    autorizacao.application
forbidden_modules =
    fastapi
    starlette
    pydantic
    boto3
    botocore
    httpx
    uvicorn

[importlinter:contract:limites-layers]
name = limites: adapters > application > domain
type = layers
layers =
    limites.adapters
    limites.application
    limites.domain

[importlinter:contract:limites-nucleo-puro]
name = limites: domain e application sem framework nem AWS SDK
type = forbidden
source_modules =
    limites.domain
    limites.application
forbidden_modules =
    fastapi
    starlette
    pydantic
    boto3
    botocore
    httpx
    uvicorn

[importlinter:contract:contabilizacao-layers]
name = contabilizacao: adapters > application > domain
type = layers
layers =
    contabilizacao.adapters
    contabilizacao.application
    contabilizacao.domain

[importlinter:contract:contabilizacao-nucleo-puro]
name = contabilizacao: domain e application sem framework nem AWS SDK
type = forbidden
source_modules =
    contabilizacao.domain
    contabilizacao.application
forbidden_modules =
    fastapi
    starlette
    pydantic
    boto3
    botocore
    httpx
    uvicorn

# Relay (Lambdas relay/sweeper/cdc-limites e o container local): entradas > adapters > núcleo.
[importlinter:contract:relay-layers]
name = relay: entradas > adapters > nucleo
type = layers
layers =
    relay.local : relay.lambda_handler : relay.sweeper
    relay.cdc_limites | relay.eventbridge | relay.outbox_dynamodb
    relay.nucleo

[importlinter:contract:relay-nucleo-puro]
name = relay: nucleo sem AWS SDK
type = forbidden
source_modules =
    relay.nucleo
forbidden_modules =
    boto3
    botocore

# Pacote compartilhado (libs/plataforma, sem dependências no pyproject). Como root_package ele é atravessado:
# um `domain -> plataforma.x -> boto3` quebra o contrato do serviço. Aqui ele mesmo fica proibido de importar
# framework e SDK.
[importlinter:contract:plataforma-pura]
name = plataforma: sem framework nem AWS SDK
type = forbidden
source_modules =
    plataforma
forbidden_modules =
    fastapi
    starlette
    pydantic
    boto3
    botocore
    httpx
    uvicorn
